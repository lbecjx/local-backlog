# OS cruft
.DS_Store

# Editor
.vscode/
.idea/

# Python cache (the old generator is gone, but guard against it recurring)
__pycache__/
*.pyc

# Logs
*.log

# Personal/local Claude Code settings — never meant to be shared
.claude/settings.local.json

# workflow-dev's own persistent context — private, per-machine, regenerable
.workflow-dev/

# This repo's own dogfooded backlog — a maintainer's working notes on
# implementing the plugin shouldn't ship to the plugin's own users. Chosen
# via /local-backlog:create-story's own gitignore-or-track question; see
# local-backlog/.backlog-config.json's "gitignored" field.
local-backlog/
